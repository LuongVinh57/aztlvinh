# Set privately in Vercel Project Settings > Environment Variables.
# Never insert real values into the HTML, Git, or chat.
ADMIN_USERNAME=
# At least 12 characters, at most 256 UTF-8 bytes.
ADMIN_PASSWORD=
# Cryptographically random >=32 bytes, encoded as 64 hex characters
# or canonical base64url (at least 43 characters). No example secret is supplied.
ADMIN_SESSION_SECRET=
# Optional public configuration: defaults server-side to this production origin.
APP_ORIGIN=https://lvinhh-azt.vercel.app
